+            # tenant notification until attribution has been established.
+            "notification_eligible": error
+            != TelephonyError.SIGNATURE_VALIDATION_FAILED,
+            "tenant_attribution_trusted": error
+            != TelephonyError.SIGNATURE_VALIDATION_FAILED,
+        },
+    )
