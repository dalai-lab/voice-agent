---
 .github/workflows/pre-pr-drift-check.yml | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/.github/workflows/pre-pr-drift-check.yml b/.github/workflows/pre-pr-drift-check.yml
index f7b6f9c7..a6765416 100644
--- a/.github/workflows/pre-pr-drift-check.yml
+++ b/.github/workflows/pre-pr-drift-check.yml
@@ -77,6 +77,8 @@ jobs:
           ENABLE_AWS_S3: "false"
           MINIO_PUBLIC_ENDPOINT: http://localhost:9000
           DEPLOYMENT_MODE: oss
+          PYTHONSAFEPATH: "1"
+          PYTHONPATH: "."
         run: python -u -m scripts.dump_docs_openapi
 
       - name: Check for OpenAPI drift
